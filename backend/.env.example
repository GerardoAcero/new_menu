# ==============================================
# Configuración del backend (copiar a .env)
# ==============================================
# Entorno: development | production | test
ENVIRONMENT=development

# --- Base de datos PostgreSQL ---
# Formato: postgresql+psycopg://usuario:password@host:puerto/nombre_bd
# Ejemplo con tu instancia local de DBeaver/PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cafeteria_db

# --- Seguridad / JWT ---
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY=cambia_esta_clave_por_una_secreta_larga
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS ---
# Orígenes permitidos separados por coma (el dev server de Expo usa estos)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# --- Depuración ---
DEBUG=true
